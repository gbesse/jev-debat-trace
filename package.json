{
  "name": "@gbesse/jev-debat-trace",
  "version": "0.1.4",
  "description": "Suit la manière dont les arguments d’un débat public français apparaissent dans les engagements ultérieurs du maître d’ouvrage.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./jev": {
      "types": "./src/jev.d.mts",
      "import": "./src/jev.mjs"
    }
  },
  "bin": {
    "jev-debat-trace": "./bin/jev-debat-trace.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "test": "node --test",
    "demo": "node examples/demo.mjs && node examples/cas-limite.mjs",
    "validate": "npm run check && npm run typecheck && npm test && npm run demo",
    "demo:principal": "node examples/demo.mjs",
    "demo:limite": "node examples/cas-limite.mjs",
    "demo:parcours": "node examples/parcours-comparatif.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-debat-trace.git"
  },
  "keywords": [
    "jev",
    "typesafe-ai",
    "cndp",
    "civic-tech",
    "france",
    "jev",
    "public-debate"
  ],
  "files": [
    "src",
    "bin",
    "docs",
    "examples",
    "scripts"
  ]
}
